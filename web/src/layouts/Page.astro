---
import '../styles/global.css';

const title = 'CALM — infinite canvas for terminals, browsers and plugins';
const description =
  'CALM is a macOS app with one pan and zoom canvas for live Ghostty terminals, browsers and plugins. Build it from source.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#090D1D" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="CALM — infinite canvas for macOS" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/banner.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="CALM — infinite canvas for macOS" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/banner.png" />

    <link rel="icon" href="/icon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
  </head>
  <body>
    <slot />
  </body>
</html>
